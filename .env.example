# ===========================================
# MicroCrew - Environment Variables Example
# ===========================================
# Copy this file to .env and fill real values
# NEVER commit real secrets

# ---------- Frontend (VITE_ prefix = exposed to browser) ----------
# Supabase URL (public, safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon key (public, safe for frontend - RLS protects data)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Backend API URL for frontend to call
VITE_API_BASE_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# ---------- Backend Only (NEVER expose to frontend) ----------
# Supabase
SUPABASE_URL=https://your-project.supabase.co
# JWKS URL for verifying Supabase JWTs
# Format: https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# OR: https://<project>.supabase.co/auth/v1/keys - check Supabase docs for your project
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Supabase JWT Issuer
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# Service role key - backend only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database - Supabase PostgreSQL connection
# Use connection pooling string for backend
DATABASE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password
# Optional: direct connection for migrations
DIRECT_DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Spring
SPRING_PROFILES_ACTIVE=dev
JWT_ISSUER=https://your-project.supabase.co/auth/v1
# For local dev, backend port
SERVER_PORT=8080

# CORS
FRONTEND_URL=http://localhost:5173

# ---------- Optional / Future ----------
# Supabase Storage
SUPABASE_STORAGE_BUCKET=microcrew-assets

# Logging
LOG_LEVEL=INFO
